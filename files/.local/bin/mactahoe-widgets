DEFAULT_OFF = frozenset({"datecard"})


def default_settings() -> dict:
    return {"widgets": {widget_id: widget_id not in DEFAULT_OFF for widget_id in WIDGETS}}


def load_settings() -> dict:
    settings = default_settings()
    try:
        saved = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
        if isinstance(saved, dict) and isinstance(saved.get("widgets"), dict):
            for widget_id in WIDGETS:
                value = saved["widgets"].get(widget_id)
                if isinstance(value, bool):
                    settings["widgets"][widget_id] = value
    except (OSError, ValueError, TypeError):
        pass
    return settings


def save_settings(settings: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".widgets-", suffix=".json")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(settings, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
        os.replace(temp_name, SETTINGS_FILE)
    finally:
        try:
            os.unlink(temp_name)
        except OSError:
            pass


def get_widget_config(widget_id: str) -> Path:
    return CONKY_DIR / f"mactahoe-{widget_id}.conf"


def widget_processes(widget_id: str) -> list[int]:
    config_name = f"mactahoe-{widget_id}.conf"
    processes = []
    try:
        proc_entries = Path("/proc").iterdir()
        for proc_entry in proc_entries:
            if not proc_entry.name.isdigit():
                continue
            try:
                args = (proc_entry / "cmdline").read_bytes().split(b"\0")
                args = [arg.decode(errors="replace") for arg in args if arg]
                if not args or Path(args[0]).name != "conky":
                    continue
                config_index = args.index("-c") + 1
                if Path(args[config_index]).name == config_name:
                    processes.append(int(proc_entry.name))
            except (OSError, ValueError, IndexError):
                continue
    except OSError:
        pass
    return processes


def is_running(widget_id: str) -> bool:
    return bool(widget_processes(widget_id))


def feeder_processes() -> list[int]:
    processes = []
    try:
        for proc_entry in Path("/proc").iterdir():
            if not proc_entry.name.isdigit():
                continue
            try:
                args = (proc_entry / "cmdline").read_bytes().split(b"\0")
                if any(Path(arg.decode(errors="replace")).name == CAVA_FEEDER.name for arg in args[:3] if arg):
                    processes.append(int(proc_entry.name))
            except OSError:
                continue
    except OSError:
        pass
    return processes


def stop_feeder() -> None:
    for pid in feeder_processes():
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass


def stop_widget(widget_id: str) -> None:
    if widget_id == "cava":
        stop_feeder()
    for pid in widget_processes(widget_id):
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 1.5
    while time.monotonic() < deadline and widget_processes(widget_id):
        time.sleep(0.05)
    for pid in widget_processes(widget_id):
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    (PID_DIR / f"{widget_id}.pid").unlink(missing_ok=True)


def conf_value(path: Path, key: str, default: int) -> int:
    try:
        match = re.search(rf"(?m)^\s*{key}\s*=\s*(\d+)", path.read_text(encoding="utf-8"))
    except OSError:
        return default
    return int(match.group(1)) if match else default


def patch_conf(content: str, source: Path, values: dict) -> str:
    for key, value in values.items():
        text = f"'{value}'" if isinstance(value, str) else str(value)
        pattern = re.compile(rf"(?m)^(\s*{key}\s*=\s*)[^,\n]+(\s*,.*)?$")
        content, count = pattern.subn(lambda match: f"{match.group(1)}{text}{match.group(2) or ''}", content, count=1)
        if count != 1:
            raise ValueError(f"Không tìm thấy {key} trong {source}")
    return content


def runtime_config(widget_id: str, gap_y: int | None, layout: dict | None = None) -> Path:
    source = get_widget_config(widget_id)
    if not source.is_file():
        raise FileNotFoundError(f"Không tìm thấy cấu hình widget: {source}")
    content = source.read_text(encoding="utf-8")
    values = {}
    if gap_y is not None:
        values["gap_y"] = gap_y
    if layout:
        values.update(layout.get("conf", {}))
    if values:
        content = patch_conf(content, source, values)
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)
    target = RUNTIME_DIR / f"mactahoe-{widget_id}.conf"
    target.write_text(content, encoding="utf-8")
    return target


def start_widget(widget_id: str, gap_y: int | None, layout: dict | None = None) -> None:
    conky = shutil.which("conky")
    if not conky:
        raise RuntimeError("Chưa cài Conky. Hãy cài lại bộ tiện ích MacTahoe.")
    if widget_id == "cava":
        if not shutil.which("cava"):
            raise RuntimeError("Chưa cài cava (sudo pacman -S cava).")
        if not CAVA_FEEDER.is_file():
            raise RuntimeError(f"Không tìm thấy {CAVA_FEEDER}")
    config = runtime_config(widget_id, gap_y, layout)
    if widget_id == "cava":
        stop_feeder()
        feeder_command = [sys.executable, str(CAVA_FEEDER)]
        if layout and layout.get("bars"):
            feeder_command.append(str(layout["bars"]))
        subprocess.Popen(
            feeder_command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        time.sleep(0.3)
    process = subprocess.Popen(
        [conky, "-c", str(config)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    PID_DIR.mkdir(parents=True, exist_ok=True)
    (PID_DIR / f"{widget_id}.pid").write_text(f"{process.pid}\n", encoding="ascii")


def calculate_positions(settings: dict) -> dict[str, int]:
    selected = settings["widgets"]
    positions = {}
    current_y = START_Y
    for widget_id in STACK_ORDER:
        if selected.get(widget_id):
            positions[widget_id] = current_y
            current_y += WIDGETS[widget_id]["height"] + WIDGET_GAP
    if selected.get("clock"):
        positions["clock"] = START_Y
    if selected.get("cava"):
        positions["cava"] = None
    if selected.get("datecard"):
        positions["datecard"] = None
    return positions


def cava_layout(settings: dict, positions: dict) -> dict | None:
    selected = settings["widgets"]
    for target in ("lunar", "system"):
        if not selected.get(target) or positions.get(target) is None:
            continue
        source = get_widget_config(target)
        side_x = conf_value(source, "gap_x", 20)
        width = conf_value(source, "minimum_width", 360) - 2 * CARD_SIDE_INSET
        height = CAVA_SIDE_HEIGHT
        if target == "lunar":
            alignment = "top_right"
            gap_y = positions[target] + CARD_TOP_INSET - CAVA_SIDE_GAP - height
        else:
            alignment = "bottom_left"
            card_top = positions[target] + conf_value(source, "minimum_height", WIDGETS[target]["height"]) - CARD_TOP_INSET
            gap_y = card_top + CAVA_SIDE_GAP
        bars = max(8, round((width + 5) / CAVA_BAR_PITCH))
        return {
            "bars": bars,
            "conf": {
                "alignment": alignment,
                "gap_x": side_x + CARD_SIDE_INSET,
                "gap_y": max(0, gap_y),
                "minimum_width": width,
                "maximum_width": width,
                "minimum_height": height,
            },
        }
    return None


def start_selected(settings: dict | None = None) -> None:
    settings = settings or load_settings()
    stop_all()
    selected = settings["widgets"]
    positions = calculate_positions(settings)
    errors = []
    for widget_id in WIDGETS:
        if not selected.get(widget_id):
            continue
        try:
            layout = cava_layout(settings, positions) if widget_id == "cava" else None
            start_widget(widget_id, positions[widget_id], layout)
        except (OSError, RuntimeError, ValueError) as exc:
            errors.append(f"{WIDGETS[widget_id]['label']}: {exc}")
    if errors:
        print("\n".join(errors), file=sys.stderr)


def stop_all() -> None:
    for widget_id in WIDGETS:
        stop_widget(widget_id)


def selected_widgets(settings: dict | None = None) -> list[str]:
    settings = settings or load_settings()
    return [widget_id for widget_id in WIDGETS if settings["widgets"].get(widget_id)]


def manager_enabled(settings: dict | None = None) -> bool:
    selected = selected_widgets(settings)
    return bool(selected) and all(is_running(widget_id) for widget_id in selected)


def load_clock_theme() -> str:
    try:
        theme = CLOCK_THEME_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        return DEFAULT_CLOCK_THEME
    return theme if theme in CLOCK_THEMES else DEFAULT_CLOCK_THEME


def save_clock_theme(theme: str) -> None:
    if theme not in CLOCK_THEMES:
        raise ValueError(f"Chủ đề màu không hợp lệ: {theme}")
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    fd, temp_name = tempfile.mkstemp(dir=CACHE_DIR, prefix=".clock-", suffix=".txt")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(theme + "\n")
        os.replace(temp_name, CLOCK_THEME_FILE)
    finally:
        try:
            os.unlink(temp_name)
        except OSError:
            pass


def load_weather_config() -> dict[str, str]:
    values = {
        "LAT": "21.0285",
        "LON": "105.8542",
        "CITY": "Hà Nội",
        "TIMEZONE": "Asia/Ho_Chi_Minh",
        "ICON_THEME": str(HOME / ".local/share/icons/WhiteSur-dark/status/symbolic"),
        "LOCATION_MODE": "manual",
    }
    try:
        for raw in WEATHER_CONFIG.read_text(encoding="utf-8").splitlines():
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            if key.strip() in values:
                values[key.strip()] = value.strip().strip('"').strip("'")
    except OSError:
        pass
    return values


def save_weather_config(config: dict[str, str]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    keys = ("LAT", "LON", "CITY", "TIMEZONE", "ICON_THEME", "LOCATION_MODE")
    lines = [f"{key}={str(config[key]).replace(chr(10), ' ').replace(chr(13), ' ')}" for key in keys]
    fd, temp_name = tempfile.mkstemp(dir=CONFIG_DIR, prefix=".weather-", suffix=".conf")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write("\n".join(lines) + "\n")
        os.replace(temp_name, WEATHER_CONFIG)
    finally:
        try:
            os.unlink(temp_name)
        except OSError:
            pass


def search_locations(query: str) -> list[dict]:
    params = urllib.parse.urlencode({"name": query, "count": 8, "language": "vi", "format": "json"})
    request = urllib.request.Request(
        f"https://geocoding-api.open-meteo.com/v1/search?{params}",
        headers={"User-Agent": "MacTahoe-Widgets/1.0", "Accept": "application/json"},
    )
    with urllib.request.urlopen(request, timeout=12) as response:
        data = json.load(response)
    return data.get("results") or []


def describe_location(location: dict) -> str:
    parts = [location.get("name"), location.get("admin1"), location.get("country")]
    return ", ".join(dict.fromkeys(part for part in parts if part))


def list_extensions() -> list[dict]:
    found: dict[str, dict] = {}
    for base in EXTENSION_DIRS:
        if not base.is_dir():
            continue
        for folder in sorted(base.iterdir()):
            meta_file = folder / "metadata.json"
            if folder.name in found or not meta_file.is_file():
                continue
            try:
                meta = json.loads(meta_file.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                continue
            description = str(meta.get("description", "")).strip().split("\n")[0]
            if len(description) > 140:
                description = description[:137].rstrip() + "..."
            found[folder.name] = {
                "uuid": folder.name,
                "name": str(meta.get("name", folder.name)),
                "description": description,
                "has_prefs": (folder / "prefs.js").is_file(),
            }
    return sorted(found.values(), key=lambda item: item["name"].lower())


def enabled_extensions() -> set[str]:
    result = subprocess.run(
        ["gsettings", "get", "org.gnome.shell", "enabled-extensions"], capture_output=True, text=True
    )
    if result.returncode != 0:
        return set()
    text = result.stdout.strip()
    if text.startswith("@as"):
        text = text[3:].strip()
    try:
        return set(ast.literal_eval(text))
    except (ValueError, SyntaxError):
        return set()


def set_extension_enabled(uuid: str, enabled: bool) -> str:
    try:
        result = subprocess.run(
            ["gnome-extensions", "enable" if enabled else "disable", uuid],
            capture_output=True,
            text=True,
            timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return str(exc)
    return "" if result.returncode == 0 else (result.stderr.strip() or result.stdout.strip() or "Lỗi không rõ")


def open_extension_prefs(uuid: str) -> str:
    try:
        subprocess.Popen(
            ["gnome-extensions", "prefs", uuid],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        return str(exc)
    return ""


def print_status() -> None:
    settings = load_settings()
    print(f"Widget MacTahoe tổng thể: {'đang bật' if manager_enabled(settings) else 'đang tắt'}")
    for widget_id, info in WIDGETS.items():
        enabled = settings["widgets"].get(widget_id, False)
        running = is_running(widget_id)
        state = "đang hiển thị" if running else "đang ẩn"
        print(f"{info['label']}: {'được chọn' if enabled else 'đã tắt'} · {state}")
    print(f"Màu đồng hồ và cava: {CLOCK_THEMES[load_clock_theme()]}")


def run_color_command(args: list[str]) -> int:
    usage = f"Cách dùng: mactahoe-widgets color [{'|'.join(CLOCK_THEMES)}]"
    if not args:
        for theme_id, name in CLOCK_THEMES.items():
            mark = "*" if theme_id == load_clock_theme() else " "
            print(f"{mark} {theme_id:10} {name}")
        return 0
    if len(args) != 1 or args[0] not in CLOCK_THEMES:
        print(usage, file=sys.stderr)
        return 2
    save_clock_theme(args[0])
    print(f"Đã đổi màu đồng hồ và cava sang: {CLOCK_THEMES[args[0]]}")
    return 0


def run_command(command: str, args: list[str] | None = None) -> int:
    args = args or []
    if command == "color":
        return run_color_command(args)
    if command == "start":
        start_selected()
        print("Đã bật các widget được chọn.")
    elif command == "stop":
        stop_all()
        print("Đã tắt widget MacTahoe.")
    elif command == "restart":
        start_selected()
        print("Đã sắp xếp và khởi động lại các widget được chọn.")
    elif command == "status":
        print_status()
    elif command == "gui":
        return -1
    elif command in ("--help", "-h"):
        print("Cách dùng: mactahoe-widgets [gui|start|stop|restart|status|color [màu]]")
        return 0
    else:
        print("Cách dùng: mactahoe-widgets [gui|start|stop|restart|status|color [màu]]", file=sys.stderr)
        return 2
    return 0


def run_gui() -> int:
    try:
        import gi

        gi.require_version("Gdk", "4.0")
        gi.require_version("Gtk", "4.0")
        from gi.repository import Gdk, Gio, GLib, Gtk
    except (ImportError, ValueError) as exc:
        print(f"Không mở được giao diện quản lý widget GTK 4: {exc}", file=sys.stderr)
        return 1

    class WidgetManager(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="vn.adfox.MacTahoeWidgets", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
            self.window = None
            self.settings = load_settings()
            self.widget_switches = {}
            self.result_locations = []
            self.city_dropdown = None
            self.status_label = None
            self.master_switch = None
            self.auto_location = None
            self.city_entry = None
            self.updating_master = False
            self.clock_dropdown = None
            self.updating_clock = False
            self.page_stack = None
            self.sidebar_list = None
            self.sidebar_page_ids = []
            self.use_city_button = None
            self.location_status = None
            self.extension_switches = {}
            self.updating_extension = False
            self.extension_status = None
            self.dind_settings = None

        def do_startup(self):
            Gtk.Application.do_startup(self)
            GLib.set_application_name(APP_TITLE)

        def do_activate(self):
            if self.window:
                self.window.present()
                return
            self.build_window()
            self.window.present()

        def build_window(self):
            self.window = Gtk.ApplicationWindow(application=self, title="")
            self.window.set_default_size(980, 680)
            self.window.set_resizable(True)

            try:
                accent_name = Gio.Settings.new("org.gnome.desktop.interface").get_string("accent-color")
            except GLib.Error:
                accent_name = ""
            accent_color = SYSTEM_ACCENT_COLORS.get(accent_name, "@theme_selected_bg_color")
            provider = Gtk.CssProvider()
            css = f"""
                @define-color app_accent {accent_color};
                window {{ background: @theme_bg_color; color: @theme_fg_color; }}
                .title {{ font-size: 24px; font-weight: 700; }}
                .subtitle {{ color: @theme_fg_color; }}
                .section-title {{ font-size: 16px; font-weight: 700; }}
                .card {{ background: @theme_base_color; border-radius: 18px; padding: 16px; }}
                .widget-title {{ font-weight: 600; }}
                .muted {{ color: @theme_fg_color; font-size: 12px; }}
                .accent {{ color: @app_accent; }}
                .sidebar-pane {{
                    background: alpha(@theme_base_color, 0.55);
                    border-right: 1px solid alpha(@theme_fg_color, 0.08);
                }}
                .sidebar-title {{ font-size: 15px; font-weight: 700; }}
                .sidebar-pane list {{ background: transparent; }}
                .sidebar-pane row {{ border-radius: 10px; margin: 2px 0; }}
                .sidebar-pane row:selected,
                .sidebar-pane row:selected:hover {{
                    background: alpha(@app_accent, 0.16);
                    color: @app_accent;
                }}
                switch:checked,
                switch:checked:hover,
                switch:checked:active,
                switch:checked:backdrop {{
                    background-color: @app_accent;
                    background-image: none;
                    box-shadow: none;
                }}
            """
            provider.load_from_data(css.encode("utf-8"))
            display = Gdk.Display.get_default()
            if display:
                Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

            root = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
            self.window.set_child(root)

            self.page_stack = Gtk.Stack()
            self.page_stack.set_hexpand(True)
            self.page_stack.set_vexpand(True)
            self.page_stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)

            root.append(self.build_sidebar())
            root.append(self.page_stack)

            for page_id, _label, _icon in SIDEBAR_PAGES:
                builder = getattr(self, f"build_page_{page_id}")
                scrolled = Gtk.ScrolledWindow()
                scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
                scrolled.set_child(builder())
                self.page_stack.add_named(scrolled, page_id)

            first_row = self.sidebar_list.get_row_at_index(0)
            if first_row:
                self.sidebar_list.select_row(first_row)
            self.refresh_status()

        def build_sidebar(self):
            pane = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            pane.add_css_class("sidebar-pane")
            pane.set_size_request(220, -1)
            pane.set_margin_top(0)

            sidebar_title = Gtk.Label(label=APP_TITLE, xalign=0)
            sidebar_title.add_css_class("sidebar-title")
            sidebar_title.set_margin_top(18)
            sidebar_title.set_margin_start(20)
            sidebar_title.set_margin_end(14)
            pane.append(sidebar_title)

            self.sidebar_list = Gtk.ListBox()
            self.sidebar_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.sidebar_list.add_css_class("navigation-sidebar")
            self.sidebar_list.set_margin_start(10)
            self.sidebar_list.set_margin_end(10)
            self.sidebar_page_ids = []
            for page_id, label, icon in SIDEBAR_PAGES:
                row = Gtk.ListBoxRow()
                box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                box.set_margin_top(9)
                box.set_margin_bottom(9)
                box.set_margin_start(10)
                box.set_margin_end(10)
                box.append(Gtk.Image.new_from_icon_name(icon))
                box.append(Gtk.Label(label=label, xalign=0, hexpand=True))
                row.set_child(box)
                self.sidebar_list.append(row)
                self.sidebar_page_ids.append(page_id)
            self.sidebar_list.connect("row-selected", self.on_page_selected)
            pane.append(self.sidebar_list)
            return pane

        def on_page_selected(self, _listbox, row):
            if row is None:
                return
            index = row.get_index()
            if 0 <= index < len(self.sidebar_page_ids):
                self.page_stack.set_visible_child_name(self.sidebar_page_ids[index])

        def make_page_box(self):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            page.set_margin_top(22)
            page.set_margin_bottom(22)
            page.set_margin_start(22)
            page.set_margin_end(22)
            return page

        def make_page_heading(self, title_text, subtitle_text):
            heading = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            title = Gtk.Label(label=title_text, xalign=0)
            title.add_css_class("title")
            subtitle = Gtk.Label(label=subtitle_text, xalign=0)
            subtitle.add_css_class("subtitle")
            heading.append(title)
            heading.append(subtitle)
            return heading

        def make_section_heading(self, text):
            label = Gtk.Label(label=text, xalign=0)
            label.add_css_class("section-title")
            return label

        def make_grid(self, min_per_line, max_per_line, homogeneous=True):
            grid = Gtk.FlowBox()
            grid.set_selection_mode(Gtk.SelectionMode.NONE)
            grid.set_homogeneous(homogeneous)
            grid.set_column_spacing(12)
            grid.set_row_spacing(12)
            grid.set_min_children_per_line(min_per_line)
            grid.set_max_children_per_line(max_per_line)
            grid.set_valign(Gtk.Align.START)
            return grid

        def make_widget_tile(self, widget_id, info):
            tile = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            tile.add_css_class("card")
            tile.set_size_request(200, 112)

            top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            label = Gtk.Label(label=info["label"], xalign=0, hexpand=True)
            label.add_css_class("widget-title")
            toggle = Gtk.Switch()
            toggle.add_css_class("system-accent")
            toggle.set_valign(Gtk.Align.CENTER)
            toggle.set_active(self.settings["widgets"].get(widget_id, widget_id not in DEFAULT_OFF))
            toggle.connect("notify::active", self.on_widget_changed, widget_id)
            self.widget_switches[widget_id] = toggle
            top.append(label)
            top.append(toggle)

            description = Gtk.Label(label=info["description"], xalign=0, yalign=0, wrap=True)
            description.set_max_width_chars(28)
            description.set_vexpand(True)
            description.add_css_class("muted")

            tile.append(top)
            tile.append(description)
            return tile

        def build_page_widgets(self):
            page = self.make_page_box()
            page.append(self.make_page_heading("Quản lý widget", "Chọn widget muốn hiển thị trên màn hình."))

            master_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            master_card.add_css_class("card")
            master_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            master_title = Gtk.Label(label="Bật widget đã chọn", xalign=0)
            master_title.add_css_class("widget-title")
            master_help = Gtk.Label(label="Công tắc tổng chỉ bật các widget đang được chọn.", xalign=0)
            master_help.add_css_class("muted")
            master_text.append(master_title)
            master_text.append(master_help)
            master_text.set_hexpand(True)
            self.master_switch = Gtk.Switch()
            self.master_switch.add_css_class("system-accent")
            self.master_switch.set_valign(Gtk.Align.CENTER)
            self.master_switch.set_active(manager_enabled(self.settings))
            self.master_switch.connect("notify::active", self.on_master_changed)
            master_card.append(master_text)
            master_card.append(self.master_switch)
            page.append(master_card)

            page.append(self.make_section_heading("Widget"))
            widget_grid = self.make_grid(2, 3)
            for widget_id, info in WIDGETS.items():
                widget_grid.append(self.make_widget_tile(widget_id, info))
            page.append(widget_grid)

            settings_grid = self.make_grid(1, 2, homogeneous=False)
            settings_grid.append(self.build_color_section())
            settings_grid.append(self.build_location_section())
            page.append(settings_grid)

            self.status_label = Gtk.Label(label="", xalign=0, wrap=True)
            self.status_label.add_css_class("accent")
            page.append(self.status_label)
            return page

        def build_page_extensions(self):
            page = self.make_page_box()
            page.append(self.make_page_heading("Gnome Extension", "Bật, tắt và chỉnh tuỳ chọn các extension của GNOME Shell."))

            dind_section = self.build_dind_section()
            if dind_section is not None:
                page.append(dind_section)

            page.append(self.make_section_heading("Extension đã cài"))
            enabled = enabled_extensions()
            list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            for info in list_extensions():
                list_box.append(self.make_extension_row(info, info["uuid"] in enabled))
            page.append(list_box)

            self.extension_status = Gtk.Label(label="", xalign=0, wrap=True)
            self.extension_status.add_css_class("accent")
            page.append(self.extension_status)
            return page

        def make_extension_row(self, info, is_enabled):
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class("card")

            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            text.set_hexpand(True)
            title = Gtk.Label(label=info["name"], xalign=0)
            title.add_css_class("widget-title")
            text.append(title)
            if info["description"]:
                description = Gtk.Label(label=info["description"], xalign=0, wrap=True)
                description.add_css_class("muted")
                text.append(description)
            row.append(text)

            if info["has_prefs"]:
                button = Gtk.Button(label="Tuỳ chọn")
                button.set_valign(Gtk.Align.CENTER)
                button.connect("clicked", self.on_extension_prefs, info["uuid"])
                row.append(button)

            toggle = Gtk.Switch()
            toggle.set_valign(Gtk.Align.CENTER)
            toggle.set_active(is_enabled)
            toggle.connect("notify::active", self.on_extension_toggled, info["uuid"], info["name"])
            self.extension_switches[info["uuid"]] = toggle
            row.append(toggle)
            return row

        def build_dind_section(self):
            schema_dir = None
            for base in EXTENSION_DIRS:
                candidate = base / DIND_UUID / "schemas"
                if (candidate / "gschemas.compiled").is_file():
                    schema_dir = candidate
                    break
            if schema_dir is None:
                return None
            try:
                source = Gio.SettingsSchemaSource.new_from_directory(
                    str(schema_dir), Gio.SettingsSchemaSource.get_default(), False
                )
                schema = source.lookup(DIND_SCHEMA, False)
                if schema is None:
                    return None
                self.dind_settings = Gio.Settings.new_full(schema, None, None)
            except GLib.Error:
                return None

            section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            section.append(self.make_section_heading("Dind"))
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            card.add_css_class("card")

            lyrics_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            lyrics_label = Gtk.Label(label="Hiện lời bài hát", xalign=0, hexpand=True)
            lyrics_switch = Gtk.Switch()
            lyrics_switch.set_valign(Gtk.Align.CENTER)
            lyrics_switch.set_active(self.dind_settings.get_boolean("lyrics-enabled"))
            lyrics_switch.connect(
                "notify::active", lambda sw, _p: self.dind_settings.set_boolean("lyrics-enabled", sw.get_active())
            )
            lyrics_row.append(lyrics_label)
            lyrics_row.append(lyrics_switch)
            card.append(lyrics_row)

            for key, label_text, unit, low, high, step in DIND_NUMBER_OPTIONS:
                option_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
                option_label = Gtk.Label(label=f"{label_text} ({unit})", xalign=0, hexpand=True)
                spin = Gtk.SpinButton.new_with_range(low, high, step)
                spin.set_valign(Gtk.Align.CENTER)
                spin.set_value(self.dind_settings.get_int(key))
                spin.connect("value-changed", lambda sp, k=key: self.dind_settings.set_int(k, int(sp.get_value())))
                option_row.append(option_label)
                option_row.append(spin)
                card.append(option_row)

            section.append(card)
            return section

        def on_extension_toggled(self, switch, _property, uuid, name):
            if self.updating_extension:
                return
            wanted = switch.get_active()
            error = set_extension_enabled(uuid, wanted)
            if error:
                self.updating_extension = True
                switch.set_active(not wanted)
                self.updating_extension = False
                self.extension_status.set_text(f"Không {'bật' if wanted else 'tắt'} được {name}: {error}")
                return
            self.extension_status.set_text(f"Đã {'bật' if wanted else 'tắt'} {name}.")

        def on_extension_prefs(self, _button, uuid):
            error = open_extension_prefs(uuid)
            if error:
                self.extension_status.set_text(f"Không mở được tuỳ chọn: {error}")

        def build_color_section(self):
            section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            section.set_valign(Gtk.Align.START)
            section.set_size_request(260, -1)
            section.append(self.make_section_heading("Màu đồng hồ và cava"))

            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            card.add_css_class("card")
            title = Gtk.Label(label="Chủ đề màu", xalign=0)
            title.add_css_class("widget-title")
            help_label = Gtk.Label(label="Đổi màu phát sáng của đồng hồ lớn và cava, áp dụng ngay.", xalign=0, wrap=True)
            help_label.add_css_class("muted")
            self.clock_theme_ids = list(CLOCK_THEMES)
            self.clock_dropdown = Gtk.DropDown.new(Gtk.StringList.new(list(CLOCK_THEMES.values())), None)
            self.clock_dropdown.set_hexpand(True)
            self.clock_dropdown.set_selected(self.clock_theme_ids.index(load_clock_theme()))
            self.clock_dropdown.connect("notify::selected", self.on_clock_theme_changed)
            card.append(title)
            card.append(help_label)
            card.append(self.clock_dropdown)
            section.append(card)
            return section

        def build_location_section(self):
            section = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            section.set_valign(Gtk.Align.START)
            section.set_size_request(260, -1)
            section.append(self.make_section_heading("Vị trí thời tiết"))

            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            card.add_css_class("card")
            weather_config = load_weather_config()
            self.auto_location = Gtk.CheckButton(label="Tự xác định vị trí gần đúng qua Internet")
            self.auto_location.set_active(weather_config.get("LOCATION_MODE") == "auto")
            card.append(self.auto_location)
            privacy = Gtk.Label(label="Dùng vị trí theo IP (không phải GPS); dịch vụ định vị sẽ thấy IP công khai của máy.", xalign=0, wrap=True)
            privacy.add_css_class("muted")
            card.append(privacy)

            city_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            self.city_entry = Gtk.Entry()
            self.city_entry.set_placeholder_text("Nhập thành phố, ví dụ: Quy Nhơn")
            self.city_entry.set_text(weather_config.get("CITY", ""))
            self.city_entry.set_hexpand(True)
            search_button = Gtk.Button(label="Tìm")
            search_button.connect("clicked", self.on_search_city)
            city_row.append(self.city_entry)
            city_row.append(search_button)
            card.append(city_row)

            self.city_dropdown = Gtk.DropDown.new(Gtk.StringList.new([]), None)
            self.city_dropdown.set_visible(False)
            card.append(self.city_dropdown)
            self.use_city_button = Gtk.Button(label="Dùng thành phố đã chọn")
            self.use_city_button.set_halign(Gtk.Align.END)
            self.use_city_button.set_visible(False)
            self.use_city_button.connect("clicked", self.on_use_city)
            card.append(self.use_city_button)

            current_city = weather_config.get("CITY", "Hà Nội")
            self.location_status = Gtk.Label(label=f"Đang dùng: {current_city}", xalign=0, wrap=True)
            self.location_status.add_css_class("muted")
            card.append(self.location_status)

            apply_location = Gtk.Button(label="Áp dụng chế độ vị trí")
            apply_location.connect("clicked", self.on_apply_location)
            card.append(apply_location)
            section.append(card)
            return section

        def set_status(self, message: str):
            self.status_label.set_text(message)

        def refresh_status(self):
            self.settings = load_settings()
            enabled = manager_enabled(self.settings)
            self.updating_master = True
            self.master_switch.set_active(enabled)
            self.updating_master = False
            if self.clock_dropdown is not None:
                self.updating_clock = True
                self.clock_dropdown.set_selected(self.clock_theme_ids.index(load_clock_theme()))
                self.updating_clock = False
            running = sum(1 for widget_id in WIDGETS if is_running(widget_id))
            self.status_label.set_text(f"{running} widget đang hiển thị. Lựa chọn widget được lưu tự động.")

        def on_master_changed(self, switch, _property):
            if self.updating_master:
                return
            if switch.get_active():
                if not selected_widgets(self.settings):
                    self.set_status("Hãy bật ít nhất một widget bên dưới trước.")
                    switch.set_active(False)
                    return
                start_selected(self.settings)
                self.set_status("Đã bật các widget được chọn và tự sắp xếp lại vị trí.")
            else:
                stop_all()
                self.set_status("Đã ẩn toàn bộ widget; lựa chọn riêng vẫn được giữ.")
            GLib.timeout_add(250, self.refresh_status_once)

        def on_clock_theme_changed(self, dropdown, _property):
            if self.updating_clock:
                return
            index = dropdown.get_selected()
            if index >= len(self.clock_theme_ids):
                return
            theme = self.clock_theme_ids[index]
            try:
                save_clock_theme(theme)
            except (OSError, ValueError) as exc:
                self.set_status(f"Không lưu được màu đồng hồ: {exc}")
                return
            self.set_status(f"Đã đổi màu đồng hồ sang {CLOCK_THEMES[theme]}.")

        def refresh_status_once(self):
            self.refresh_status()
            return GLib.SOURCE_REMOVE

        def on_widget_changed(self, switch, _property, widget_id):
            self.settings["widgets"][widget_id] = switch.get_active()
            save_settings(self.settings)
            master_was_on = manager_enabled(self.settings) or any(is_running(item) for item in WIDGETS)
            if master_was_on:
                start_selected(self.settings)
                self.set_status("Đã cập nhật widget và dồn lại các widget đang bật.")
            else:
                self.set_status("Đã lưu lựa chọn. Bật công tắc tổng để hiển thị các widget đã chọn.")
            GLib.timeout_add(250, self.refresh_status_once)

        def on_search_city(self, _button):
            query = self.city_entry.get_text().strip()
            if not query:
                self.set_status("Nhập tên thành phố cần tìm trước.")
                return
            self.set_status("Đang tìm thành phố…")

            def worker():
                try:
                    results = search_locations(query)
                    error = "" if results else "Không tìm thấy thành phố phù hợp."
                except Exception as exc:
                    results = []
                    error = f"Không tìm được vị trí: {exc}"
                GLib.idle_add(self.show_search_results, results, error)

            threading.Thread(target=worker, daemon=True).start()

        def show_search_results(self, results, error):
            self.result_locations = results
            if not results:
                self.city_dropdown.set_visible(False)
                self.use_city_button.set_visible(False)
                self.set_status(error)
                return GLib.SOURCE_REMOVE
            labels = [describe_location(location) for location in results]
            self.city_dropdown.set_model(Gtk.StringList.new(labels))
            self.city_dropdown.set_selected(0)
            self.city_dropdown.set_visible(True)
            self.use_city_button.set_visible(True)
            self.set_status(f"Tìm thấy {len(results)} vị trí. Chọn đúng thành phố rồi bấm Dùng thành phố đã chọn.")
            return GLib.SOURCE_REMOVE

        def on_use_city(self, _button):
            selected_index = self.city_dropdown.get_selected()
            if selected_index >= len(self.result_locations):
                self.set_status("Hãy tìm và chọn thành phố trước.")
                return
            location = self.result_locations[selected_index]
            config = load_weather_config()
            config.update({
                "LAT": str(location.get("latitude", config["LAT"])),
                "LON": str(location.get("longitude", config["LON"])),
                "CITY": describe_location(location),
                "TIMEZONE": str(location.get("timezone") or "auto"),
                "LOCATION_MODE": "manual",
            })
            self.auto_location.set_active(False)
            save_weather_config(config)
            self.city_entry.set_text(config["CITY"])
            self.location_status.set_text(f"Đang dùng: {config['CITY']}")
            self.set_status("Đã lưu thành phố. Đang cập nhật thời tiết…")
            self.refresh_weather_async("manual")

        def on_apply_location(self, _button):
            config = load_weather_config()
            if self.auto_location.get_active():
                config["LOCATION_MODE"] = "auto"
                save_weather_config(config)
                self.location_status.set_text("Đang dùng vị trí tự động gần đúng theo IP.")
                self.set_status("Đang xác định vị trí và cập nhật thời tiết…")
                self.refresh_weather_async("auto")
            else:
                config["LOCATION_MODE"] = "manual"
                save_weather_config(config)
                self.location_status.set_text(f"Đang dùng: {config.get("CITY", "Hà Nội")}")
                self.set_status("Đã lưu chế độ thành phố thủ công. Đang cập nhật thời tiết…")
                self.refresh_weather_async("manual")

        def refresh_weather_async(self, mode):
            def worker():
                try:
                    result = subprocess.run(
                        [sys.executable, str(WEATHER_FETCHER), "--force"],
                        capture_output=True,
                        text=True,
                        timeout=30,
                    )
                    error = result.returncode != 0
                except (OSError, subprocess.TimeoutExpired) as exc:
                    error = True
                    result = None
                    message = str(exc)
                else:
                    message = (result.stderr or result.stdout or "").strip()
                GLib.idle_add(self.weather_updated, mode, error, message)

            threading.Thread(target=worker, daemon=True).start()

        def weather_updated(self, mode, error, message):
            config = load_weather_config()
            if error:
                location = "Không xác định được vị trí tự động; dùng vị trí đã lưu." if mode == "auto" else "Không cập nhật được dữ liệu thời tiết."
                if message:
                    location += f" ({message})"
                self.location_status.set_text(location)
                self.set_status(location)
            else:
                state = {}
                try:
                    for line in (CACHE_DIR / "weather.state").read_text(encoding="utf-8").splitlines():
                        if "=" in line:
                            key, value = line.split("=", 1)
                            state[key] = value
                except OSError:
                    pass
                active_city = state.get("city", config.get("CITY", ""))
                self.location_status.set_text(f"Đang dùng: {active_city}")
                self.set_status(f"Đã cập nhật thời tiết cho {active_city}.")
            if is_running("weather"):
                start_selected(load_settings())
            return GLib.SOURCE_REMOVE

    application = WidgetManager()
    return application.run([sys.argv[0]])


def main() -> int:
    if len(sys.argv) > 1:
        result = run_command(sys.argv[1], sys.argv[2:])
        if result >= 0:
            return result
    return run_gui()


if __name__ == "__main__":
    sys.exit(main())
