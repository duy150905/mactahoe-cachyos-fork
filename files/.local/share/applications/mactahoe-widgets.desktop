[Desktop Entry]
Type=Application
Name=MacTahoe Settings
Comment=Cài đặt widget và Gnome Extension của MacTahoe
Exec=@HOME@/.local/bin/mactahoe-widgets
Icon=@HOME@/.local/share/mactahoe-widgets/mactahoe-settings.svg
StartupWMClass=vn.adfox.MacTahoeWidgets
Terminal=false
Categories=Utility;
Keywords=extension;settings;conky;weather;system;widget;calendar;
